{
  "name": "@local/dsh-chat-bubbles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Soft-blue assistant chat bubbles with message-specific quoted replies in the DSH composer.",
  "keywords": ["dsh", "dsh-plugin", "chat", "bubbles", "reply"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "test": "node --test test/client.test.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["sessions", "conversation", "uiConversation"]
    }
  }
}
