{
  "name": "@local/dsh-session-agent-preset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Switch a DSH session's Agent preset from its conversation header while idle.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "agent-preset"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["slots", "connection"]
    }
  }
}
