{
  "name": "@local/dsh-session-tabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-style session tabs for the DSH Web GUI: one tab per opened session at the top of the conversation area, with click-to-switch, close, drag-reorder, running-state dots, and a New session button.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-tabs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
